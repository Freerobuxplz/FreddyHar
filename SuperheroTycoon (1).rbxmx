    <bool name="Disabled">false</bool>
    <ProtectedString name="Source"><![CDATA[
local button = script.Parent
local plot = button.Parent
local clickDetector = button:WaitForChild("ClickDetector")
local cost = 100

clickDetector.MouseClick:Connect(function(plr)
	if plot.OwnerId.Value ~= plr.UserId then return end
	local stats = plr:FindFirstChild("leaderstats")
	if stats and stats.Cash.Value >= cost then
		stats.Cash.Value = stats.Cash.Value - cost
		plot.Wall.Transparency = 1
		plot.Wall.CanCollide = false
		button.Transparency = 1
		button.CanCollide = false
		clickDetector:Destroy()
	end
end)

]]></ProtectedString>
  </Properties>
