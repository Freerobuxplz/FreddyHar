    <Item class="Script" referent="REF173">
  <Properties>
    <string name="Name">PlotManagerScript</string>
    <bool name="Disabled">false</bool>
    <ProtectedString name="Source"><![CDATA[
local root = script.Parent
local Plots = root:WaitForChild("Plots")
local plotList = Plots:GetChildren()
local playerPlots = {}

local function getFreePlot()
	for _, plot in ipairs(plotList) do
		if plot.OwnerId.Value == 0 then
			return plot
		end
	end
	return nil
end

local function resetPlot(plot)
	plot.OwnerId.Value = 0
	plot.Sign.BillboardGui.TextLabel.Text = "Empty Plot"

	plot.Wall.Transparency = 0
	plot.Wall.CanCollide = true

	for _, buttonName in ipairs({"BuyWallButton", "BuyDropper2Button", "BuySpeedButton", "BuyJumpButton", "BuyFlightButton"}) do
		local button = plot:FindFirstChild(buttonName)
		if button then
			button.Transparency = 0
			button.CanCollide = true
			if not button:FindFirstChild("ClickDetector") then
				local cd = Instance.new("ClickDetector")
				cd.Name = "ClickDetector"
				cd.MaxActivationDistance = 15
				cd.Parent = button
			end
		end
	end

	plot.Dropper2.Transparency = 1
	plot.Dropper2.CanCollide = false
	plot.Dropper2.DropCash.Disabled = true

	for _, obj in ipairs(workspace:GetChildren()) do
		if obj.Name == "Cash" and obj:GetAttribute("PlotName") == plot.Name then
			obj:Destroy()
		end
	end
end

local function applyUpgrades(plr, character, plot)
	local humanoid = character:WaitForChild("Humanoid")
	if plr:GetAttribute("HasSuperSpeed") then
		humanoid.WalkSpeed = 50
	end
	if plr:GetAttribute("HasSuperJump") then
		humanoid.JumpPower = 100
	end
	if plr:GetAttribute("HasFlightCape") then
		local template = root:FindFirstChild("FlightCapeTemplate")
		if template and not plr.Backpack:FindFirstChild(template.Name) and not character:FindFirstChild(template.Name) then
			local clone = template:Clone()
			clone.Parent = plr.Backpack
		end
	end
end

game.Players.PlayerAdded:Connect(function(plr)
	local plot = getFreePlot()
	if not plot then
		plr:Kick("All superhero plots are full right now, try again soon!")
		return
	end

	plot.OwnerId.Value = plr.UserId
	plot.Sign.BillboardGui.TextLabel.Text = plr.Name .. "'s Tycoon"
	playerPlots[plr.UserId] = plot

	plr.CharacterAdded:Connect(function(character)
		task.wait(1)
		local hrp = character:WaitForChild("HumanoidRootPart")
		hrp.CFrame = plot.PlotSpawn.CFrame + Vector3.new(0, 3, 0)
		applyUpgrades(plr, character, plot)
	end)
end)

game.Players.PlayerRemoving:Connect(function(plr)
	local plot = playerPlots[plr.UserId]
	if plot then
		resetPlot(plot)
		playerPlots[plr.UserId] = nil
	end
end)

]]></ProtectedString>
  </Properties>
</Item>
    <Item class="Tool" referent="REF170">
  <Properties>
    <string name="Name">Cape of Flight</string>
    <bool name="RequiresHandle">false</bool>
    <bool name="CanBeDropped">false</bool>
  </Properties>
  <Item class="LocalScript" referent="REF171">
  <Properties>
    <string name="Name">FlightControl</string>
    <bool name="Disabled">false</bool>
    <ProtectedString name="Source"><![CDATA[
local tool = script.Parent
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local flying = false
local bodyVelocity

local function stopFlight()
	flying = false
	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end
end

tool.Equipped:Connect(function()
	local character = tool.Parent
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	local inputConn = UIS.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.F then
			flying = not flying
			local hrp = character:FindFirstChild("HumanoidRootPart")
			if flying and hrp then
				bodyVelocity = Instance.new("BodyVelocity")
				bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
				bodyVelocity.Velocity = Vector3.new(0, 0, 0)
				bodyVelocity.Parent = hrp
				if humanoid then
					humanoid:ChangeState(Enum.HumanoidStateType.Physics)
				end
			else
				stopFlight()
				if humanoid then
					humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
				end
			end
		end
	end)

	local heartbeatConn = RunService.Heartbeat:Connect(function()
		if flying and bodyVelocity and humanoid then
			local moveDir = humanoid.MoveDirection
			bodyVelocity.Velocity = Vector3.new(moveDir.X, 0, moveDir.Z) * 50 + Vector3.new(0, 40, 0)
		end
	end)

	tool.Unequipped:Connect(function()
		stopFlight()
		inputConn:Disconnect()
		heartbeatConn:Disconnect()
	end)
end)

]]></ProtectedString>
  </Properties>
</Item>
</Item>
