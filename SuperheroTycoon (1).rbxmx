    <string name="Name">DropCash</string>
    <bool name="Disabled">false</bool>
    <ProtectedString name="Source"><![CDATA[
local dropper = script.Parent
local plot = dropper.Parent

while true do
	task.wait(2)
	if plot.OwnerId.Value ~= 0 then
		local cash = Instance.new("Part")
		cash.Name = "Cash"
		cash.Size = Vector3.new(1, 1, 1)
		cash.Shape = Enum.PartType.Ball
		cash.BrickColor = BrickColor.new("New Yeller")
		cash.CanCollide = false
		cash.Anchored = false
		cash.CFrame = dropper.CFrame + Vector3.new(0, 4, 0)
		cash:SetAttribute("PlotName", plot.Name)
		cash:SetAttribute("Value", 5)
		cash.Parent = workspace
		game:GetService("Debris"):AddItem(cash, 10)
	end
end

]]></ProtectedString>
  </Properties>
