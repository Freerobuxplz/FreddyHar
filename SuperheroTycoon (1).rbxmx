  <Item class="Script" referent="REF34">
  <Properties>
    <string name="Name">CollectCash</string>
    <bool name="Disabled">false</bool>
    <ProtectedString name="Source"><![CDATA[
local collector = script.Parent
local plot = collector.Parent
local debounce = {}

collector.Touched:Connect(function(hit)
	if hit.Name == "Cash" and hit:GetAttribute("PlotName") == plot.Name and not debounce[hit] then
		debounce[hit] = true
		local ownerId = plot.OwnerId.Value
		local plr = game.Players:GetPlayerByUserId(ownerId)
		local value = hit:GetAttribute("Value") or 5
		hit:Destroy()
		if plr then
			local stats = plr:FindFirstChild("leaderstats")
			if stats then
				stats.Cash.Value = stats.Cash.Value + value
			end
		end
	end
end)

]]></ProtectedString>
  </Properties>
</Item>
</Item>
