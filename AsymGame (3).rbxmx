<?xml version="1.0" encoding="utf-8"?>
<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">

	<!-- ==================================================================== -->
	<!-- 1) ReplicatedStorage/CharacterData  (ModuleScript)                    -->
	<!-- ==================================================================== -->
	<Item class="ModuleScript" referent="ITEM_CharacterData">
		<Properties>
			<string name="Name">CharacterData</string>
			<ProtectedString name="Source"><![CDATA[
local CharacterData = {}

CharacterData.Survivors = {
	Sonic = {
		AssetId = 348401846,
		Abilities = {"PeelOut", "DropDash"},
	},
	Amy = {
		AssetId = 2869746401,
		Abilities = {"HammerHit", "HammerThrow"},
	},
	Knuckles = {
		AssetId = 9922792744,
		Abilities = {"GroundPunch", "Block"},
	},
	Tails = {
		AssetId = 9755551117,
		Abilities = {"Glide", "HighPitchScream"},
	},
}

CharacterData.Killers = {
	VERTEX = {
		AssetId = 73188668618288,
		Abilities = {"Lunge", "Invisible"},
	},
}

CharacterData.SurvivorOrder = {"Sonic", "Amy", "Knuckles", "Tails"}

CharacterData.MaxHealth = 100

return CharacterData
]]></ProtectedString>
		</Properties>
	</Item>

	<!-- ==================================================================== -->
	<!-- 2) ServerScriptService/RoundState  (ModuleScript, shared server state) -->
	<!-- ==================================================================== -->
	<Item class="ModuleScript" referent="ITEM_RoundState">
		<Properties>
			<string name="Name">RoundState</string>
			<ProtectedString name="Source"><![CDATA[
local RoundState = {}

RoundState.Phase = "Intermission" -- Intermission, Selection, Teleporting, InRound, Ended
RoundState.RoundActive = false
RoundState.Players = {} -- [player] = data table

RoundState.Debug = {
	FreezeIntermission = false, -- toggle: holds the intermission countdown in place
	TimerOverride = nil,        -- number|nil: next countdown tick will jump to this value
	ForceEndRound = false,      -- one-shot: ends the in-progress round on the next tick
	ForceSpawnRing = false,     -- one-shot: spawns the escape ring immediately
}

function RoundState.new(player)
	RoundState.Players[player] = {
		Role = nil,        -- "Survivor" or "Killer"
		Character = nil,   -- e.g. "Sonic"
		Health = 100,
		Alive = true,
		Escaped = false,
		Stunned = false,
		Frozen = false,
		Invisible = false,
		Cooldowns = {},
		LockedOut = {},
	}
	return RoundState.Players[player]
end

function RoundState.get(player)
	return RoundState.Players[player]
end

function RoundState.reset(player)
	local d = RoundState.Players[player]
	if not d then return end
	d.Health = 100
	d.Alive = true
	d.Escaped = false
	d.Stunned = false
	d.Frozen = false
	d.Invisible = false
	d.Cooldowns = {}
	d.LockedOut = {}
end

return RoundState
]]></ProtectedString>
		</Properties>
	</Item>

