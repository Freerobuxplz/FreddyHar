-- Feedback line
local feedbackRow = debugRow(50)
local feedbackLabel = newLabel("FeedbackLabel", feedbackRow, UDim2.new(1,0,1,0), UDim2.new(0,0,0,0), "", 13)
feedbackLabel.TextWrapped = true
feedbackLabel.TextXAlignment = Enum.TextXAlignment.Left
feedbackLabel.TextYAlignment = Enum.TextYAlignment.Top

DebugFeedback.OnClientEvent:Connect(function(msg)
	feedbackLabel.Text = msg
	local state = msg:match("^Freeze Intermission: (%a+)")
	if state then
		freezeBtn.Text = "Freeze Intermission: " .. state:upper()
	end
end)

DebugAuthorized.OnClientEvent:Connect(function(authorized)
	isAuthorizedDebug = authorized
	debugFrame.Visible = authorized
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.F4 and isAuthorizedDebug then
		debugFrame.Visible = not debugFrame.Visible
	end
end)

-- ===================== INVISIBILITY VISUAL =====================

local function watchCharacterForInvisibility(char)
	char.AttributeChanged:Connect(function(attr)
		if attr == "IsInvisible" then
			local invisible = char:GetAttribute("IsInvisible")
			local isMe = (char == player.Character)
			if isMe then return end
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Transparency = invisible and 1 or 0
				end
			end
		end
	end)
end

Players.PlayerAdded:Connect(function(p)
	p.CharacterAdded:Connect(watchCharacterForInvisibility)
end)
for _, p in ipairs(Players:GetPlayers()) do
	if p.Character then watchCharacterForInvisibility(p.Character) end
	p.CharacterAdded:Connect(watchCharacterForInvisibility)
end
